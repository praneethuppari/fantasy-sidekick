# Fantasy Sidekick local environment
APP_ENV=development
LOG_LEVEL=INFO

# Local Postgres (docker-compose maps container 5432 -> host 5433)
DATABASE_URL=postgresql+psycopg://fantasy:fantasy@localhost:5433/fantasy_sidekick

